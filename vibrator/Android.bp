// CAF vendor/qcom/opensource/vibrator/aidl (LA.UM.9.x) + LED amplitude via
// the PMI632 LDO vmax_mv node, so Android's vibration intensity works.
cc_binary {
    name: "android.hardware.vibrator-service.a02q",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.a02q.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.a02q.xml"],
    cflags: ["-Wall", "-Werror"],
    srcs: [
        "Vibrator.cpp",
        "service.cpp",
    ],
    local_include_dirs: ["include"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "android.hardware.vibrator-V1-ndk_platform",
    ],
}
